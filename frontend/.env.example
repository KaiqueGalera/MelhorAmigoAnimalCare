# Endereço do back-end Spring Boot usado pelo proxy do Vite (apenas em `npm run dev`).
VITE_BACKEND_URL=http://localhost:8080

# Prefixo das chamadas feitas pelo navegador.
# Vazio = mesma origem (usa o proxy em dev, ou o mesmo servidor em produção).
# Em produção com domínios separados, informe a URL completa, ex.: https://api.minhaclinica.com.br
VITE_API_BASE_URL=
